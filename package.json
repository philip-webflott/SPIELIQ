{
  "name": "spieliq",
  "private": true,
  "description": "SPIELIQ – interaktive Lernplattform für Spielverständnis im Jugendfußball",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @spieliq/web dev",
    "build": "pnpm --filter @spieliq/web build",
    "start": "pnpm --filter @spieliq/web start",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @spieliq/web test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @spieliq/web db:generate",
    "db:deploy": "pnpm --filter @spieliq/web db:deploy",
    "db:migrate": "pnpm --filter @spieliq/web db:migrate",
    "db:seed": "pnpm --filter @spieliq/web db:seed",
    "content:report": "pnpm --filter @spieliq/content report",
    "voice": "pnpm --filter @spieliq/web voice"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
