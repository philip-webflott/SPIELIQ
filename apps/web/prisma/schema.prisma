// SPIELIQ – Datenmodell (PostgreSQL, Prisma ORM 7)
// Grundsätze (docs/architektur/datenmodell.md):
// - Datensparsamkeit: Spielerkonten ohne E-Mail, ohne Geburtsdatum, ohne Klarnamenpflicht
// - Mandantentrennung: Jede Mannschaft gehört genau einer Organisation (Verein/Fußballschule)
// - Offizielle Lerninhalte liegen versioniert im Code (@spieliq/content), nicht in der Datenbank
// - Versuche speichern die Spielereingabe, damit jede Bewertung reproduzierbar ist

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountKind {
  ADULT // Trainer:in, Vereinsverantwortliche:r – Anmeldung mit E-Mail
  PLAYER // Spieler:in – pseudonymes Konto, Anmeldung mit Spielernamen
}

enum PlatformRole {
  USER
  ADMIN
}

enum OrganizationKind {
  CLUB
  SCHOOL
  ACADEMY
  PRIVATE
}

enum OrgRole {
  OWNER
  ADMIN
  COACH
}

enum TeamRole {
  HEAD_COACH
  ASSISTANT_COACH
  PLAYER
}

enum AgeGroup {
  G
  F
  E
  D
  C
  B
  A
}

enum MissionStatus {
  IN_PROGRESS
  COMPLETED
}

enum FieldRating {
  NOT_OBSERVED
  EMERGING
  CONSISTENT
}

enum ConsentKind {
  PRIVACY_NOTICE // Datenschutzhinweise zur Kenntnis genommen
  GUARDIAN_CONSENT // Einwilligung der Sorgeberechtigten (unter 16) liegt dem Verein vor
}

model User {
  id           String       @id @default(cuid())
  kind         AccountKind
  /// Anzeigename; bei Spielern ein selbst gewählter Spitzname (kein Klarname nötig)
  displayName  String
  /// Nur Erwachsene
  email        String?      @unique
  /// Nur Spieler: generierter Anmeldename, z. B. "flinker-falke-37"
  loginName    String?      @unique
  passwordHash String
  platformRole PlatformRole @default(USER)
  locale       String       @default("de")
  /// Klar gekennzeichnete Demo-Daten (Seed), niemals echte Personen
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastLoginAt  DateTime?

  sessions           Session[]
  orgMemberships     OrgMembership[]
  teamMemberships    TeamMembership[]
  attempts           Attempt[]
  missionProgress    MissionProgress[]
  consents           ConsentRecord[]           @relation("consentSubject")
  consentsRecorded   ConsentRecord[]           @relation("consentRecorder")
  observationsGiven  FieldObservation[]        @relation("observer")
  observationsAbout  FieldObservation[]        @relation("observed")
  assignmentsCreated Assignment[]
  invitationsCreated Invitation[]
}

model Session {
  /// SHA-256-Hash des Sitzungstokens (das Token selbst wird nie gespeichert)
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Drosselung von Anmeldeversuchen; Schlüssel ist ein Hash des Kennworts-Ziels (kein Klartext, keine IP)
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  kind      OrganizationKind @default(CLUB)
  isDemo    Boolean          @default(false)
  createdAt DateTime         @default(now())

  memberships OrgMembership[]
  teams       Team[]
}

model OrgMembership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Team {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  ageGroup  AgeGroup
  season    String?
  createdAt DateTime @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  memberships  TeamMembership[]
  invitations  Invitation[]
  assignments  Assignment[]
  observations FieldObservation[]

  @@index([orgId])
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole
  /// Vom Trainer zugeordnetes Lernniveau (1 Einsteiger … 5 fortgeschritten), optional
  level     Int?
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  teamId      String
  /// SHA-256 des normalisierten Einladungscodes
  codeHash    String    @unique
  /// Letzte Zeichen zur Wiedererkennung in der Oberfläche
  codeHint    String
  role        TeamRole  @default(PLAYER)
  createdById String
  expiresAt   DateTime
  maxUses     Int       @default(40)
  uses        Int       @default(0)
  /// Trainer:in hat bestätigt, dass dem Verein die Einwilligungen der Sorgeberechtigten vorliegen
  guardianConsentConfirmedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model ConsentRecord {
  id           String      @id @default(cuid())
  userId       String
  kind         ConsentKind
  /// Version des Texts, dem zugestimmt bzw. der zur Kenntnis genommen wurde
  version      String
  /// z. B. "verein-bestaetigt" (Trainer bestätigt, dass die Einwilligung dem Verein vorliegt)
  method       String
  recordedById String?
  grantedAt    DateTime    @default(now())
  revokedAt    DateTime?
  user         User        @relation("consentSubject", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy   User?       @relation("consentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([userId, kind])
}

/// Ein Bewertungsversuch eines interaktiven Missionsschritts (serverseitig neu berechnet)
model Attempt {
  id             String      @id @default(cuid())
  userId         String
  missionId      String
  missionVersion Int
  stepId         String
  /// Spielereingabe (Positionen bzw. Auswahl) – Grundlage für reproduzierbare Neubewertung
  answer         Json
  rating         String
  score          Float
  /// Prinzip-ID → bestanden
  principles     Json
  /// Kompakte Kriterienergebnisse: [{ id, passed, score, feedbackKey }]
  criteria       Json
  hintsUsed      Int         @default(0)
  durationMs     Int?
  assignmentId   String?
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment     Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([userId, missionId])
  @@index([assignmentId])
}

model MissionProgress {
  id             String        @id @default(cuid())
  userId         String
  missionId      String
  missionVersion Int
  status         MissionStatus
  bestRating     String?
  attempts       Int           @default(0)
  hintsUsed      Int           @default(0)
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}

/// Hausaufgabe: Missionen für eine Mannschaft oder einzelne Spieler
model Assignment {
  id               String    @id @default(cuid())
  teamId           String
  createdById      String
  title            String
  missionIds       String[]
  dueAt            DateTime?
  estimatedMinutes Int
  note             String?
  /// Leer = ganze Mannschaft
  targetUserIds    String[]
  createdAt        DateTime  @default(now())
  archivedAt       DateTime?
  team             Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy        User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attempts         Attempt[]

  @@index([teamId])
}

/// Trainerbeobachtung im Training – die einzige Quelle für "auf dem Platz angewendet"
model FieldObservation {
  id          String      @id @default(cuid())
  teamId      String
  playerId    String
  observerId  String
  principleId String
  rating      FieldRating
  observedOn  DateTime
  /// Kurze sachliche Notiz (max. 280 Zeichen), keine sensiblen Daten
  note        String?
  createdAt   DateTime    @default(now())
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player      User        @relation("observed", fields: [playerId], references: [id], onDelete: Cascade)
  observer    User        @relation("observer", fields: [observerId], references: [id], onDelete: Cascade)

  @@index([teamId, playerId])
}

/// Von Trainern erstellte Szenarien (Editor folgt; gleiches Format wie offizielle Missionen)
model CustomScenario {
  id            String   @id @default(cuid())
  orgId         String
  authorId      String
  title         String
  /// Szenario im Format @spieliq/engine missionSchema (schemaVersion 1)
  data          Json
  schemaVersion Int      @default(1)
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId])
}

/// Protokoll sicherheits- und datenschutzrelevanter Aktionen (wer hat wann was getan)
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}
