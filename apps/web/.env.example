# Lokale Entwicklung – Kopie als .env anlegen (nie committen)
DATABASE_URL="postgresql://spieliq:spieliq@localhost:5432/spieliq?schema=public"
# Für Integrationstests (wird von den Tests geleert!)
TEST_DATABASE_URL="postgresql://spieliq:spieliq@localhost:5432/spieliq_test?schema=public"

# Optional (Online-Vorschau, siehe docs/betrieb/vorschau-vercel-supabase.md):
# DIRECT_URL="…"            # Verbindung für Migrationen (Supabase: Session-Pooler, Port 5432)
# DATABASE_CA_CERT="…"      # CA-Zertifikat der Datenbank – dann wird das Serverzertifikat geprüft
# SEED_DEMO_DATA="true"     # Demo-Daten beim Vercel-Build anlegen bzw. zurücksetzen

# Nur zum Vertonen der Vorlesetexte (pnpm voice, siehe docs/konzept/sprachausgabe.md).
# Die App braucht diese Werte nicht – in Vercel NICHT eintragen.
# ELEVENLABS_API_KEY="…"      # geheim; Schlüssel nur mit Berechtigung „Text to Speech“ und Zeichenlimit anlegen
# ELEVENLABS_VOICE_ID="…"     # ID der gewählten Stimme
# ELEVENLABS_MODEL_ID="eleven_v4"
# ELEVENLABS_SPEED="0.9"      # etwas langsamer als normal (Annahme, im Test mit Kindern prüfen)
